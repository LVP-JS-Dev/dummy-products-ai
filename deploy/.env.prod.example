# Production environment (Docker Hub)
# Copy to .env.prod and update values

# Docker Hub images
DOCKER_USERNAME=your-docker-hub-username

# Use latest prod tag (auto-updated on each master push)
WEB_IMAGE=${DOCKER_USERNAME}/dummy-products-web:prod
DOCS_IMAGE=${DOCKER_USERNAME}/dummy-products-docs:prod

# Or pin to specific commit for reproducible deploys:
# WEB_IMAGE=${DOCKER_USERNAME}/dummy-products-web:prod-abc1234
# DOCS_IMAGE=${DOCKER_USERNAME}/dummy-products-docs:prod-abc1234

# Or use version tag for releases:
# WEB_IMAGE=${DOCKER_USERNAME}/dummy-products-web:v1.2.3
# DOCS_IMAGE=${DOCKER_USERNAME}/dummy-products-docs:v1.2.3

# Or use digest for immutable deploys:
# WEB_IMAGE=${DOCKER_USERNAME}/dummy-products-web@sha256:<digest>
# DOCS_IMAGE=${DOCKER_USERNAME}/dummy-products-docs@sha256:<digest>
