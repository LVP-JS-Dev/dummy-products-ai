# Stage environment (Docker Hub)
# Copy to .env.stage and update values

# Docker Hub images
DOCKER_USERNAME=your-docker-hub-username

# Use latest stage tag (auto-updated on each develop push)
WEB_IMAGE=${DOCKER_USERNAME}/dummy-products-web:stage
DOCS_IMAGE=${DOCKER_USERNAME}/dummy-products-docs:stage

# Or pin to specific commit for reproducible deploys:
# WEB_IMAGE=${DOCKER_USERNAME}/dummy-products-web:stage-abc1234
# DOCS_IMAGE=${DOCKER_USERNAME}/dummy-products-docs:stage-abc1234

# Or use digest for immutable deploys:
# WEB_IMAGE=${DOCKER_USERNAME}/dummy-products-web@sha256:<digest>
# DOCS_IMAGE=${DOCKER_USERNAME}/dummy-products-docs@sha256:<digest>
