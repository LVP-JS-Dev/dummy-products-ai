{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PageNumber",
  "type": "object",
  "additionalProperties": false,
  "required": ["value", "selected"],
  "properties": {
    "value": {
      "anyOf": [
        { "type": "integer" },
        { "type": "string" }
      ]
    },
    "selected": {
      "type": "boolean"
    },
    "disabled": {
      "type": "boolean"
    }
  }
}
