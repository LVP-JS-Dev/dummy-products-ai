{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Checkbox",
  "type": "object",
  "additionalProperties": false,
  "required": ["checked"],
  "properties": {
    "checked": {
      "type": "boolean"
    },
    "label": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    }
  }
}
