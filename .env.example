# CI/local fallback credentials (not required for app runtime)
GHCR_TOKEN=ghp_your_pat_here
GHCR_USERNAME=your-ghcr-namespace
NPM_TOKEN=npm_your_token_here

# Dokploy image references (use digests for reproducible deploys)
DOCS_IMAGE=ghcr.io/your-ghcr-namespace/dummy-products-docs@sha256:your-image-digest
WEB_IMAGE=ghcr.io/your-ghcr-namespace/dummy-products-web@sha256:your-image-digest
