# GitHub Actions CI/CD Configuration
# Copy these values to GitHub repository settings

# ===========================================
# Secrets (Settings → Secrets and variables → Actions → Secrets)
# ===========================================

# Docker Hub credentials (required for image builds)
DOCKER_USERNAME=your-docker-hub-username
DOCKER_TOKEN=dckr_pat_xxx  # Docker Hub access token with read/write permissions

# npm token for publishing burlaki package (optional, only for releases)
NPM_TOKEN=npm_xxx  # npm access token with publish permissions

# ===========================================
# Variables (Settings → Secrets and variables → Actions → Variables)
# ===========================================

# DOCKER_USERNAME can also be set as a variable (non-secret)
# This is useful if you prefer to keep secrets minimal
# DOCKER_USERNAME=your-docker-hub-username

# ===========================================
# Priority Order
# ===========================================
# 1. Secrets (encrypted, higher priority)
# 2. Variables (non-encrypted, fallback)
#
# Example: If DOCKER_USERNAME is set in both secrets and variables,
# the secret value will be used.

# ===========================================
# How to create Docker Hub token
# ===========================================
# 1. Go to https://hub.docker.com/settings/security
# 2. Click "New Access Token"
# 3. Select permissions: Read, Write, Delete
# 4. Copy the token (shown only once)

# ===========================================
# How to create npm token
# ===========================================
# 1. Go to https://www.npmjs.com/settings/tokens
# 2. Click "Generate New Token" → "Classic Token"
# 3. Select "Automation" type
# 4. Copy the token
